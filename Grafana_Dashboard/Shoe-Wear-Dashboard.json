  "panels": [
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_GARMIN_STATS}"
      },
      "description": "Distance run with each pair, as a percentage of its maximum distance set in Garmin Connect. A pair with no maximum distance has no bar. Gear data is only fetched when `gear` is in FETCH_SELECTION.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "displayName": "${__series.name}",
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-green"
              },
              {
                "color": "light-yellow",
                "value": 60
              },
              {
                "color": "semi-dark-orange",
                "value": 75
              },
              {
                "color": "semi-dark-red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "displayMode": "lcd",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "maxVizHeight": 40,
        "minVizHeight": 24,
        "minVizWidth": 8,
        "namePlacement": "top",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "manual",
        "text": {
          "titleSize": 14,
          "valueSize": 18
        },
        "valueMode": "color"
      },
      "pluginVersion": "13.3.1",
      "targets": [
        {
          "alias": "$tag_GearName",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_GARMIN_STATS}"
          },
          "query": "SELECT last(\"TotalDistance\") / last(\"MaximumDistance\") * 100 FROM \"GearStats\" WHERE $timeFilter AND \"GearType\" = 'Shoes' AND \"GearStatus\" =~ /^$GearStatus$/ GROUP BY \"GearName\"",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        }
      ],
      "title": "Shoe wear",
      "transparent": true,
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_GARMIN_STATS}"
      },
      "description": "Distance run, distance left before the maximum set in Garmin Connect, and number of runs for each pair. Gear data is only fetched when `gear` is in FETCH_SELECTION.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false,
            "inspect": false
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text"
              }
            ]
          },
          "unit": "lengthm"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pair"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Runs"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Remaining"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "noValue",
                "value": "No max set"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "semi-dark-red"
                    },
                    {
                      "color": "semi-dark-orange",
                      "value": 100000
                    },
                    {
                      "color": "semi-dark-green",
                      "value": 200000
                    }
                  ]
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Distance"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 14,
        "x": 10,
        "y": 0
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Remaining"
          }
        ]
      },
      "pluginVersion": "13.3.1",
      "targets": [
        {
          "alias": "",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_GARMIN_STATS}"
          },
          "query": "SELECT last(\"TotalDistance\") AS \"Distance\", last(\"MaximumDistance\") - last(\"TotalDistance\") AS \"Remaining\", last(\"TotalActivities\") AS \"Runs\" FROM \"GearStats\" WHERE $timeFilter AND \"GearType\" = 'Shoes' AND \"GearStatus\" =~ /^$GearStatus$/ GROUP BY \"GearName\"",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "table"
        }
      ],
      "title": "Shoe details",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Distance": 1,
              "GearName": 0,
              "Remaining": 2,
              "Runs": 3
            },
            "renameByName": {
              "GearName": "Pair"
            }
          }
        }
      ],
      "transparent": true,
      "type": "table"
    }
  ],
